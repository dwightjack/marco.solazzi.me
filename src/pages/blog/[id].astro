---
import Layout from '../../layouts/Layout.astro';
import Page from '../../components/Page.astro';
import PageSection from '../../components/PageSection.astro';
import { getCollection, render } from 'astro:content';
import { NAV_PATH_BLOG } from '../../shared/constants';
import SkipContent from '../../components/SkipContent.astro';
import Footer from '../../sections/Footer.astro';

export async function getStaticPaths() {
  const blogEntries = await getCollection('blog');
  return blogEntries.map((post) => ({
    params: { id: post.id },
    props: { post },
  }));
}

const { post } = Astro.props;
const { Content } = await render(post);

const { title, publishDate, lastUpdateDate, excerpt, isDraft } = post.data;

const formattedDate = publishDate.toLocaleString('en-US', {
  dateStyle: 'medium',
  timeZone: 'UTC',
});

const formattedLastUpdateDate = lastUpdateDate
  ? lastUpdateDate.toLocaleString('en-US', {
      dateStyle: 'medium',
      timeZone: 'UTC',
    })
  : null;

const schema = {
  '@context': 'https://schema.org',
  '@type': 'BlogPosting',
  headline: title,
  description: excerpt,
  keywords: [],
  url: new URL(Astro.url.pathname, Astro.site),
  author: {
    '@type': 'Person',
    name: 'Marco Solazzi',
    url: Astro.site,
  },
  inLanguage: 'en-US',
  datePublished: publishDate.toISOString(),
};
---

<Layout title={title} description={excerpt} currentNav={NAV_PATH_BLOG}>
  <script
    is:inline
    slot="head"
    type="application/ld+json"
    set:html={JSON.stringify(schema)}
  />
  <SkipContent slot="header" target="heading" />
  <div class="p-stack p-stack--away">
    <Page id={NAV_PATH_BLOG}
      ><PageSection title="blog.post">
        <section class="p-prose">
          <hgroup id="heading" tabindex="-1" aria-label="Post heading">
            <h1>{title}</h1>
            <p class="small">
              {isDraft && '(draft) '}
              {
                lastUpdateDate && (
                  <>
                    Updated on{' '}
                    <time datetime={lastUpdateDate.toISOString()}>
                      {formattedLastUpdateDate}
                    </time>{' '}
                    -
                  </>
                )
              }
              Published on <time datetime={publishDate.toISOString()}
                >{formattedDate}</time
              >
              - <a href={NAV_PATH_BLOG}>Blog Archive</a>
            </p>
          </hgroup>
          <Content />
        </section></PageSection
      >
    </Page>
    <Footer />
  </div>
</Layout>
<script>
  import { NAV_PATH_BLOG } from '../../shared/constants';
  import { currentRoute } from '../../shared/store';
  import { initialize as tableScroller } from '../../shared/patterns/tableScroller';
  currentRoute.set(NAV_PATH_BLOG);
  tableScroller();
</script>
